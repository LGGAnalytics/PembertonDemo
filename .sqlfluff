[sqlfluff]
dialect = postgres
max_line_length = 120
# Style-only rules that clash with the repository's established SQL layout
# (aligned columns, client-mirroring comments, keyword column names such as
# status / mode / level). Rules that catch real defects stay on.
exclude_rules = LT01, LT02, LT05, CP01, CP02, CP03, CP04, CP05, AL01, RF04
