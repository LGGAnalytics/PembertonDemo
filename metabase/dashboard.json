{
  "dashboard": {
    "name": "Direct Lending Portfolio Monitor",
    "description": "Private credit portfolio monitoring. Reads only the bi.* views (layer 3), which read the treated dbo.* tables loaded by the dbo.usp_* procedures from staging.*. Synthetic demo data.",
    "collection": "Direct Lending Demo"
  },
  "filters": [
    {
      "id": "fund",
      "name": "Fund",
      "slug": "fund",
      "type": "string/=",
      "values": [
        "EDL-III",
        "EDL-IV",
        "SCF-I"
      ]
    }
  ],
  "palette": {
    "navy": "#192C50",
    "blue": "#3D7CC9",
    "blue_secondary": "#195094",
    "slate": "#474D70",
    "stone": "#D7D2CB",
    "fund_series": {
      "EDL-III": "#3D7CC9",
      "EDL-IV": "#6BBD4A",
      "SCF-I": "#7D63BD"
    }
  },
  "cards": [
    {
      "key": "header",
      "type": "text",
      "text": "**Data flow:** `staging` (raw extracts, as-is) → `dbo` (treated tables, loaded by `dbo.usp_*` stored procedures) → `bi` (views) → Metabase  ·  month-end, EUR  ·  synthetic demo data",
      "layout": {
        "row": 0,
        "col": 0,
        "size_x": 24,
        "size_y": 1
      }
    },
    {
      "key": "kpi_commitments",
      "name": "Commitments",
      "display": "smartscalar",
      "sql": "cards/kpi_commitments.sql",
      "format": {
        "column": "Commitments (EUR bn)",
        "prefix": "€",
        "suffix": "bn"
